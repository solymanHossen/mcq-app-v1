generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// Phase 1 — Authentication
//
// Exam/question-bank/attempt/result/anti-cheat models are intentionally not
// modeled yet. They depend on an unresolved design question (reusable question
// bank vs. exam-owned questions) and belong to Phase 2+, not this migration.
// ============================================================================

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

model User {
  id              String    @id @default(uuid())
  name            String
  email           String    @unique
  passwordHash    String
  role            Role      @default(STUDENT)
  isActive        Boolean   @default(true)
  isEmailVerified Boolean   @default(false)
  lastLoginAt     DateTime?

  // Bumped to invalidate every existing session at once (forced logout on
  // password reset, admin-triggered revocation). Server-side guards re-check
  // this against the value embedded in the session on every protected
  // request — see lib/auth/guards.ts.
  tokenVersion    Int       @default(0)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  authTokens      AuthToken[]
  auditLogs       AuditLog[]

  questions       Question[]       @relation("TeacherQuestions")
  exams           Exam[]           @relation("TeacherExams")
  reportsFiled    QuestionReport[] @relation("ReportedQuestions")
  reportsResolved QuestionReport[] @relation("ResolvedReports")
  examAttempts    ExamAttempt[]    @relation("StudentAttempts")
  gradingAuditLogs GradingAuditLog[]
  violationEvents    ViolationEvent[]  @relation("StudentViolations")
  reviewedViolations ViolationEvent[]  @relation("ReviewedViolations")
  appealsFiled       ViolationAppeal[] @relation("StudentAppeals")
  appealsResolved    ViolationAppeal[] @relation("ResolvedAppeals")

  @@index([role, isActive])
}

enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

// Backs both the 6-digit email-verification OTP and the password-reset link.
// Only a SHA-256 hash of the code/token is ever stored, so a DB leak doesn't
// hand out usable codes. `attempts` throttles brute-forcing the 6-digit OTP
// space (10^6 is small enough to matter).
model AuthToken {
  id         String           @id @default(uuid())
  tokenHash  String           @unique
  purpose    AuthTokenPurpose
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int              @default(0)

  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt  DateTime         @default(now())

  @@index([userId, purpose, consumedAt])
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  REGISTER
  EMAIL_VERIFIED
  EMAIL_VERIFY_FAILED
  OTP_RESENT
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  RATE_LIMITED
  SESSION_REVOKED
}

// Doubles as the security audit trail AND the data source for rate-limit
// counters (count rows of a given action/key within a time window). No
// separate ephemeral rate-limit store yet — see lib/auth/rate-limit.ts for
// the tradeoff this implies at high volume.
model AuditLog {
  id         String      @id @default(uuid())
  action     AuditAction
  success    Boolean     @default(true)

  // `identifier` carries the email for pre-auth actions (login, register,
  // forgot-password) where there's no authenticated actor yet.
  identifier String?
  ip         String?
  metadata   Json?

  actorId    String?
  actor      User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)

  createdAt  DateTime    @default(now())

  @@index([action, identifier, createdAt])
  @@index([action, ip, createdAt])
  @@index([actorId, createdAt])
}

// ============================================================================
// Phase 2 — Teacher dashboard & reusable question bank
//
// Questions are owned per-teacher and private to them (no shared/school-wide
// pool yet — see the cross-teacher authorization requirement this phase
// implements). Adding a bank Question to an Exam SNAPSHOTS its content onto
// the ExamQuestion row at that moment: editing or even deleting the bank
// Question afterward never changes an exam that already includes it. This is
// the simplest rule that satisfies "preserve the integrity of published
// exams" — no separate "snapshot at publish" behavior to reason about.
// ============================================================================

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum OptionChoice {
  A
  B
  C
  D
}

enum QuestionType {
  // The only type implemented so far; the field/filter exist so a future
  // type (true/false, multi-select, …) doesn't require a schema migration.
  SINGLE_CORRECT_MCQ
}

enum QuestionStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Question {
  id            String         @id @default(uuid())
  teacherId     String
  teacher       User           @relation("TeacherQuestions", fields: [teacherId], references: [id], onDelete: Cascade)

  type          QuestionType   @default(SINGLE_CORRECT_MCQ)
  status        QuestionStatus @default(DRAFT)

  subject       String
  topic         String
  difficulty    Difficulty     @default(MEDIUM)

  questionText  String         @db.Text
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctOption OptionChoice

  explanation   String?        @db.Text
  imageUrl      String?
  codeSnippet   String?        @db.Text
  codeLanguage  String?

  // sha256 of normalized question text + option set, for duplicate detection.
  contentHash   String

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  examQuestions ExamQuestion[]
  reports       QuestionReport[]

  @@index([teacherId, status])
  @@index([teacherId, subject])
  @@index([teacherId, topic])
  @@index([teacherId, difficulty])
  @@index([teacherId, contentHash])
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TieBreakerPolicy {
  TIME_TAKEN_ASC // faster submission (submittedAt - startedAt) wins — the default
  SUBMITTED_AT_ASC // earlier wall-clock submission wins
  ACCURACY_DESC // higher correct/(correct+incorrect) wins
}

model Exam {
  id               String     @id @default(uuid())
  teacherId        String
  teacher          User       @relation("TeacherExams", fields: [teacherId], references: [id], onDelete: Cascade)

  title            String
  description      String?    @db.Text
  status           ExamStatus @default(DRAFT)

  durationMinutes  Int
  maxAttempts      Int        @default(1)
  shuffleQuestions Boolean    @default(true)
  shuffleOptions   Boolean    @default(false)
  passingMarks     Float?

  // Scheduling window. "Is this exam currently open" is derived from
  // (status == PUBLISHED && now within [startTime, endTime]) rather than
  // stored as its own status, so the two can never disagree.
  startTime        DateTime?
  endTime          DateTime?

  publishedAt      DateTime?
  archivedAt       DateTime?

  // Two independent disclosure gates: a result can be published (the
  // student sees their score) without the answer key being released (the
  // student still never sees which option was correct). Both are one-way,
  // like publishing itself — never un-release.
  answerKeyReleased   Boolean   @default(false)
  answerKeyReleasedAt DateTime?

  // Leaderboard config — see lib/leaderboard/engine.ts for exactly how each
  // policy breaks a tie.
  leaderboardEnabled Boolean          @default(true)
  tieBreakerPolicy   TieBreakerPolicy @default(TIME_TAKEN_ASC)

  // Anti-cheat config — see lib/anti-cheat/engine.ts for the fixed,
  // documented severity weight per ViolationType. Crossing this cumulative
  // score FLAGS the attempt for mandatory human review; it never
  // disqualifies anything by itself.
  violationReviewThreshold Int     @default(5)
  // No image/video is ever captured or stored by this system — see
  // lib/anti-cheat/engine.ts. This only gates starting the attempt behind
  // an explicit, recorded consent.
  webcamMonitoringRequired Boolean @default(false)

  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  examQuestions    ExamQuestion[]
  attempts         ExamAttempt[]
  gradingAuditLogs GradingAuditLog[]

  @@index([teacherId, status])
}

model ExamQuestion {
  id                    String       @id @default(uuid())

  examId                String
  exam                  Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)

  // Nullable + SetNull: if the source bank question is later deleted, this
  // exam's own (already-snapshotted) copy must still survive intact.
  questionId            String?
  question              Question?    @relation(fields: [questionId], references: [id], onDelete: SetNull)

  order                 Int
  marks                 Float        @default(1)
  // Deducted (not added) for a wrong answer; 0 disables negative marking for
  // this question. Never negative itself — see lib/validators/exam.ts.
  negativeMarks         Float        @default(0)

  // Post-publication correction, not a Phase 2 edit: a teacher can cancel a
  // question found to be wrong/ambiguous after students have already
  // attempted it. A cancelled question awards full marks to every attempt
  // regardless of what was selected, and is excluded from correct/incorrect
  // counts — see lib/grading/engine.ts for the exact policy.
  isCancelled           Boolean      @default(false)

  questionTextSnapshot  String       @db.Text
  optionASnapshot       String
  optionBSnapshot       String
  optionCSnapshot       String
  optionDSnapshot       String
  correctOptionSnapshot OptionChoice
  explanationSnapshot   String?      @db.Text

  createdAt             DateTime     @default(now())

  attemptAnswers        AttemptAnswer[]
  gradingAuditLogs      GradingAuditLog[]

  @@unique([examId, questionId])
  @@index([examId, order])
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model QuestionReport {
  id             String       @id @default(uuid())

  questionId     String
  question       Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)

  reportedById   String
  reportedBy     User         @relation("ReportedQuestions", fields: [reportedById], references: [id], onDelete: Cascade)

  reason         String
  status         ReportStatus @default(OPEN)
  resolutionNote String?      @db.Text

  resolvedById   String?
  resolvedBy     User?        @relation("ResolvedReports", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt     DateTime?

  createdAt      DateTime     @default(now())

  @@index([questionId, status])
  @@index([status])
}

// ============================================================================
// Phase 3 — Exam-taking engine
//
// AttemptAnswer rows are pre-created for every ExamQuestion the moment an
// attempt starts (selectedOption null = unanswered). This fixes the set of
// answerable questions for that attempt up front: an autosave can only ever
// update an existing (attemptId, examQuestionId) row, so a tampered or
// stale examQuestionId naturally matches nothing instead of needing a
// separate membership check. No grading/scoring here — that's a later phase;
// this one only captures what the student selected.
// ============================================================================

enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
  TIMEOUT
  // No anti-cheat engine sets this yet (out of scope so far) — it exists now
  // specifically so the leaderboard's filtering logic has a real status to
  // exclude, per Phase 5's explicit requirement, via disqualifyAttemptAction.
  DISQUALIFIED
}

model ExamAttempt {
  id            String        @id @default(uuid())

  examId        String
  exam          Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)

  studentId     String
  student       User          @relation("StudentAttempts", fields: [studentId], references: [id], onDelete: Cascade)

  attemptNumber Int
  status        AttemptStatus @default(IN_PROGRESS)

  // Server-computed once at creation: startedAt + exam.durationMinutes,
  // capped by exam.endTime if the exam closes sooner. This is the ONLY
  // source of truth for how long the student has — never a client timer.
  startedAt     DateTime      @default(now())
  deadline      DateTime
  submittedAt   DateTime?

  // Set only via disqualifyAttemptAction — excluded from every leaderboard
  // query regardless of its (still-computed, still-visible-to-the-student)
  // ExamResult.
  disqualifiedReason String?  @db.Text
  // Preserved at disqualification time so an ACCEPTED appeal can restore
  // the exact prior state instead of guessing what it should revert to.
  statusBeforeDisqualification AttemptStatus?

  // Set the moment a cumulative violation severity score first crosses
  // exam.violationReviewThreshold — a visible, mandatory-review marker,
  // never an automatic status change. Left set even after review so the
  // history is visible.
  flaggedForReviewAt DateTime?

  // Session-conflict detection: the opaque per-page-load token the
  // exam-taking client sends with every answer save. A different token
  // appearing for the same attempt while the previous one was recently
  // active is itself the server-detected evidence — see
  // lib/anti-cheat/engine.ts. Never a device fingerprint or IP.
  activeSessionToken   String?
  activeSessionTokenAt DateTime?

  // Required before starting an attempt on a webcamMonitoringRequired exam.
  webcamConsentGivenAt DateTime?

  answers          AttemptAnswer[]
  result           ExamResult?
  gradingAuditLogs GradingAuditLog[]
  violationEvents  ViolationEvent[]
  appeals          ViolationAppeal[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([studentId, examId, attemptNumber])
  @@index([examId, status])
  @@index([studentId, examId])
  @@index([status, deadline])
}

model AttemptAnswer {
  id                String       @id @default(uuid())

  attemptId         String
  attempt           ExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  examQuestionId    String
  examQuestion      ExamQuestion @relation(fields: [examQuestionId], references: [id], onDelete: Cascade)

  selectedOption    OptionChoice?
  isMarkedForReview Boolean      @default(false)

  // Presentation order when exam.shuffleQuestions is on — randomized once at
  // attempt start and stable for the rest of the attempt.
  presentationOrder Int

  // The client's own clock at the moment of the edit that produced the
  // current value, NOT a trusted timestamp for anything else. Conflict
  // resolution for concurrent saves (e.g. two open tabs) compares this: a
  // save only applies if its clientUpdatedAt is strictly newer than what's
  // stored, so an out-of-order network retry can never clobber a later
  // edit, and resubmitting the same edit is a safe no-op (idempotent).
  clientUpdatedAt   DateTime

  updatedAt         DateTime     @updatedAt
  createdAt         DateTime     @default(now())

  @@unique([attemptId, examQuestionId])
  @@index([attemptId])
}

// ============================================================================
// Phase 4 — Grading & results
//
// Grading always re-reads the CURRENT ExamQuestion rows (marks,
// negativeMarks, correctOptionSnapshot, isCancelled) at the moment it runs —
// never a cached value — so a later answer-key correction is automatically
// reflected the next time an attempt is (re)graded. See lib/grading/engine.ts
// for the scoring policy and lib/grading/arithmetic.ts for the rounding
// policy.
// ============================================================================

enum ResultStatus {
  PROVISIONAL
  PUBLISHED
}

model ExamResult {
  id             String       @id @default(uuid())

  attemptId      String       @unique
  attempt        ExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  status         ResultStatus @default(PROVISIONAL)

  totalMarks     Float
  obtainedMarks  Float
  correctCount   Int
  incorrectCount Int
  skippedCount   Int
  cancelledCount Int
  accuracy       Float
  isPassed       Boolean?

  // Optimistic-concurrency guard for regrading — see
  // lib/grading/regrade.ts. Bumped on every regrade.
  gradingVersion Int          @default(1)

  gradedAt       DateTime     @default(now())
  publishedAt    DateTime?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

enum GradingAuditAction {
  GRADED
  REGRADED
  RESULTS_PUBLISHED
  QUESTION_CORRECTED
  QUESTION_CANCELLED
  ATTEMPT_DISQUALIFIED
  ATTEMPT_REQUALIFIED
  ATTEMPT_FLAGGED_FOR_REVIEW
}

// Separate from the Phase 1 AuditLog (auth/security events): this is
// pedagogically/legally significant data about how a specific score came to
// be, keyed by exam/attempt/question rather than by identifier/ip.
model GradingAuditLog {
  id             String             @id @default(uuid())

  examId         String
  exam           Exam               @relation(fields: [examId], references: [id], onDelete: Cascade)

  attemptId      String?
  attempt        ExamAttempt?       @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  examQuestionId String?
  examQuestion   ExamQuestion?      @relation(fields: [examQuestionId], references: [id], onDelete: SetNull)

  action         GradingAuditAction
  // Null actor = the automatic system grading that runs on every submission;
  // non-null = a teacher/admin-initiated correction, regrade, or publish.
  actorId        String?
  actor          User?              @relation(fields: [actorId], references: [id], onDelete: SetNull)

  previousScore  Float?
  newScore       Float?
  reason         String?            @db.Text
  metadata       Json?

  createdAt      DateTime           @default(now())

  @@index([examId, createdAt])
  @@index([attemptId, createdAt])
}

// ============================================================================
// Phase 6 — Anti-cheat & examination audit
//
// ViolationEvent rows are append-only: once created, type / source /
// severity / metadata / timestamp / studentId / attemptId never change —
// only reviewStatus (and the review fields that go with it) is ever
// updated, itself an explicitly audited transition, never a silent edit of
// the original evidence. See lib/anti-cheat/engine.ts for the severity
// policy, the never-auto-disqualify rule, and exactly what each event type's
// metadata is allowed to contain (deliberately minimal — never raw device
// fingerprints, IP, or location).
// ============================================================================

enum ViolationType {
  TAB_SWITCH
  WINDOW_BLUR
  FULLSCREEN_EXIT
  COPY_ATTEMPT
  PASTE_ATTEMPT
  RIGHT_CLICK_ATTEMPT
  DEVTOOLS_DETECTED
  MULTIPLE_TABS_DETECTED
  // Server-detected only — see below. A client can never report these two
  // itself; the server derives them from its own observations.
  SESSION_CONFLICT
  SUSPICIOUS_REQUEST_PATTERN
  // Reserved for a future client-side webcam integration (not implemented
  // here — see lib/anti-cheat/engine.ts). The consent gate and these event
  // types exist now so that integration has somewhere to report into.
  WEBCAM_NO_FACE
  WEBCAM_MULTIPLE_FACES
}

enum ViolationSeverity {
  LOW
  MEDIUM
  HIGH
}

// The structural answer to "do not assume client-reported events are
// trustworthy proof of misconduct": CLIENT_REPORTED is the browser's own
// account of what it observed (spoofable, suppressible, sometimes just
// wrong); SERVER_DETECTED is derived entirely from the server's own
// observations of request behavior and needs no trust in the client at all.
// A review UI must show this distinction, never blur it.
enum ViolationSource {
  CLIENT_REPORTED
  SERVER_DETECTED
}

enum ViolationReviewStatus {
  OPEN
  REVIEWED_NO_ACTION
  REVIEWED_WARNING_ISSUED
  REVIEWED_DISQUALIFIED
}

model ViolationEvent {
  id        String            @id @default(uuid())

  attemptId String
  attempt   ExamAttempt       @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  studentId String
  student   User              @relation("StudentViolations", fields: [studentId], references: [id], onDelete: Cascade)

  type      ViolationType
  source    ViolationSource
  severity  ViolationSeverity

  metadata  Json?

  // Server-generated, always — the entire point is that this can't be
  // backdated or forged by the client.
  occurredAt DateTime @default(now())

  reviewStatus ViolationReviewStatus @default(OPEN)
  reviewNote   String?               @db.Text
  reviewedById String?
  reviewedBy   User?                 @relation("ReviewedViolations", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?

  @@index([attemptId, occurredAt])
  @@index([studentId, occurredAt])
  @@index([reviewStatus])
}

enum AppealStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model ViolationAppeal {
  id        String       @id @default(uuid())

  attemptId String
  attempt   ExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  studentId String
  student   User         @relation("StudentAppeals", fields: [studentId], references: [id], onDelete: Cascade)

  explanation String     @db.Text
  status      AppealStatus @default(PENDING)

  resolvedById   String?
  resolvedBy     User?     @relation("ResolvedAppeals", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolutionNote String?   @db.Text
  resolvedAt     DateTime?

  createdAt DateTime @default(now())

  @@index([attemptId])
  @@index([status])
}
