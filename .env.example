NEXTAUTH_SECRET=your-secret-key
AUTH_SECRET=your-secret-key

# Local Postgres, matches docker-compose.yml
DATABASE_URL="postgresql://mcq:mcq@localhost:5432/mcq_platform?schema=public"

# Bearer token the scheduled sweep-expired-attempts job must present
CRON_SECRET=your-cron-secret

# Optional — leaderboard caching only. The app runs correctly with this
# unset (queries go straight to Postgres); matches docker-compose.yml.
REDIS_URL="redis://localhost:6379"

# Optional — AI-powered mistake explanations. Unset by default: the feature
# is simply unavailable (not degraded) without it, and nothing in exam
# submission/grading depends on it.
ANTHROPIC_API_KEY=
ANTHROPIC_EXPLANATION_MODEL="claude-haiku-4-5-20251001"

# Optional — Postgres connection pool tuning (see lib/db.ts and
# docs/performance-audit.md for the measurements behind these defaults).
# DB_POOL_MAX must be sized against Postgres's own max_connections divided
# across every app instance that will connect concurrently.
DB_POOL_MAX=20
DB_POOL_CONNECTION_TIMEOUT_MS=5000
