# Application branding (accessible client- and server-side)
NEXT_PUBLIC_APP_NAME="ExamHub"
NEXT_PUBLIC_APP_DESCRIPTION="Build question banks, run timed exams, and auto-grade results with proctoring, leaderboards, and AI explanations."

NEXTAUTH_SECRET=your-secret-key
AUTH_SECRET=your-secret-key

# The deployment's own public URL — NextAuth uses this to determine cookie
# security (the `Secure` flag is only added once this is https://) and
# actions/billing.actions.ts uses it to build checkout success/cancel URLs.
# Required in production; NextAuth can infer it from the request in dev.
NEXTAUTH_URL="https://your-production-domain.example"

# Local Postgres, matches docker-compose.yml
DATABASE_URL="postgresql://mcq:mcq@localhost:5432/mcq_platform?schema=public"

# Bearer token the scheduled cron jobs must present (sweep-expired-attempts,
# purge-violation-events) — both check the same secret.
CRON_SECRET=your-cron-secret

# Optional — leaderboard caching only. The app runs correctly with this
# unset (queries go straight to Postgres); matches docker-compose.yml.
REDIS_URL="redis://localhost:6379"

# Optional — AI-powered mistake explanations. Unset by default: the feature
# is simply unavailable (not degraded) without it, and nothing in exam
# submission/grading depends on it.
ANTHROPIC_API_KEY=
ANTHROPIC_EXPLANATION_MODEL="claude-haiku-4-5-20251001"

# Optional — Postgres connection pool tuning (see lib/db.ts and
# docs/performance-audit.md for the measurements behind these defaults).
# DB_POOL_MAX must be sized against Postgres's own max_connections divided
# across every app instance that will connect concurrently.
DB_POOL_MAX=20
DB_POOL_CONNECTION_TIMEOUT_MS=5000

# Optional — payment processing (lib/payments/provider.ts). Unset by
# default: subscribing/refunding returns a clear "not configured" error
# rather than silently failing, and nothing in exam submission/grading
# depends on this. STRIPE_WEBHOOK_SECRET is what verifies an incoming
# webhook actually came from Stripe (see lib/payments/signature.ts) — never
# leave this unset in any environment that's reachable from the internet.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
